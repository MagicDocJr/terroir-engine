; PROTOTYPE — Terroir Engine first-pass UI (throwaway). Godot 4.7 (.NET build; UI is GDScript only).
config_version=5

[application]

config/name="Terroir UI prototype"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

timers/tooltip_delay_sec=0.25

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.109, 0.137, 0.165, 1)
