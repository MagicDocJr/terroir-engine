 "glossary": [
  {
   "term": "Estate",
   "text": "Your wine business. It owns Plots and makes Wine from them."
  },
  {
   "term": "Region",
   "text": "A real wine region with its own climate, soils, hazards and wine law, such as the Mosel."
  },
  {
   "term": "Plot",
   "text": "A piece of land in a Region that the Estate can buy. It is divided into Blocks."
  },
  {
   "term": "Block",
   "text": "A zone within a Plot with its own soil and microclimate. It is planted, managed and harvested as a unit."
  },
  {
   "term": "Classification",
   "text": "A Plot's legal standing in its Region's appellation system. It caps the Legal category of its wine."
  },
  {
   "term": "Variety",
   "text": "A grape cultivar you can plant, such as Riesling. Any Variety can go anywhere; a poor match shows in the results."
  },
  {
   "term": "Planting",
   "text": "The one-off choices when vines go into bare land: Variety, clone, rootstock, density, row orientation, training system."
  },
  {
   "term": "Establishment",
   "text": "The young-vine years before the first full crop, about three. The game fast-forwards through them."
  },
  {
   "term": "Vintage",
   "text": "One growing season and the wine made from it, named by harvest year."
  },
  {
   "term": "Programme",
   "text": "A standing instruction for one area of work, set to Low, Medium or High. Staff carry it out daily."
  },
  {
   "term": "Alert",
   "text": "Something in the simulation that stops time and needs your attention."
  },
  {
   "term": "Staff level",
   "text": "Junior, Experienced or Senior. Higher levels work better and explain more; advice is correct at every level."
  },
  {
   "term": "Mentor",
   "text": "An expert about to retire who guides you through your first Vintage."
  },
  {
   "term": "Lot",
   "text": "The fruit of one Block in one Vintage, fermented and aged as its own batch."
  },
  {
   "term": "Wine",
   "text": "A finished, bottled product made from one Lot or a blend of Lots."
  },
  {
   "term": "Legal category",
   "text": "The designation a Wine qualifies for under its Region's rules, such as Mosel Kabinett. The main driver of price."
  },
  {
   "term": "Tasting sheet",
   "text": "The structured assessment of a Wine. Every descriptor is linked to the decision or condition that caused it."
  },
  {
   "term": "°Oechsle (°Oe)",
   "text": "German measure of must weight: how much denser than water the juice is. 1.084 g/mL = 84 °Oe."
  },
  {
   "term": "°Brix",
   "text": "Sugar content of juice as a percentage by weight. Roughly °Oe divided by 4.2 at typical must weights."
  },
  {
   "term": "Titratable acidity (TA)",
   "text": "Total acid in must or wine, reported here in g/L as tartaric acid."
  },
  {
   "term": "pH",
   "text": "How strong the acidity is. Lower pH means sharper acidity, better colour stability and more effective SO₂."
  },
  {
   "term": "Stem water potential (Ψstem)",
   "text": "How hard the vine has to pull water, in megapascals. More negative means more water stress."
  },
  {
   "term": "YAN",
   "text": "Yeast assimilable nitrogen, in mg N/L. Too little slows fermentation and can cause off-smells."
  },
  {
   "term": "Malolactic conversion (MLF)",
   "text": "Bacteria turn sharp malic acid into softer lactic acid. Lowers acidity, raises pH."
  },
  {
   "term": "Botrytis cinerea",
   "text": "A fungus. On healthy, ripe grapes in misty-then-dry weather it becomes noble rot; in wet weather it is grey rot."
  },
  {
   "term": "Downy mildew",
   "text": "A disease (Plasmopara viticola) spread by rain on warm days. Attacks leaves and young bunches."
  },
  {
   "term": "Powdery mildew",
   "text": "A fungal disease (Erysiphe necator) favoured by warm, shaded, humid conditions without rain."
  },
  {
   "term": "Veraison",
   "text": "The stage when berries soften and change colour. Sugar builds up and acidity falls from here on."
  },
  {
   "term": "Prädikat",
   "text": "German quality levels set by must weight at harvest: Kabinett, Spätlese, Auslese, Beerenauslese, Trockenbeerenauslese, Eiswein."
  },
  {
   "term": "Feinherb",
   "text": "A German label term for off-dry wines. It has no legal definition."
  },
  {
   "term": "Einzelpfahl",
   "text": "Single-stake training traditional on steep Mosel slopes: each vine tied to its own stake, with two canes bent into a heart shape."
  },
  {
   "term": "Fuder",
   "text": "The traditional Mosel oak cask, 1 000 litres."
  },
  {
   "term": "Barrique",
   "text": "A 225-litre oak barrel."
  },
  {
   "term": "Growing degree days (GDD)",
   "text": "Daily mean temperature above 10 °C, added up over the season. A measure of heat available for ripening."
  },
  {
   "term": "Winkler index",
   "text": "Growing degree days from April to October (Northern Hemisphere), grouped into Regions I–V."
  },
  {
   "term": "Huglin index",
   "text": "A heat index that weights daytime maximum temperatures and day length, often used in Europe."
  },
  {
   "term": "Rootstock",
   "text": "The root part of a grafted vine. Chosen for phylloxera resistance, vigour, and tolerance of drought or lime."
  }
 ],
