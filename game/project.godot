; Terroir Engine — the MVP game (Godot 4.7 .NET). UI in GDScript, simulation in C# (../sim, ADR 0001/0003).
config_version=5

[application]

config/name="Terroir Engine"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

Sim="*res://src/bridge/SimBridge.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="TerroirGame"

[gui]

timers/tooltip_delay_sec=0.25

[rendering]

environment/defaults/default_clear_color=Color(0.109, 0.137, 0.165, 1)
anti_aliasing/quality/msaa_3d=2
